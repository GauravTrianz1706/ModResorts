# Docker ignore file for Java Maven project
# Exclude build artifacts and unnecessary files from Docker context

# Maven build artifacts
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# CRITICAL: Exclude Maven wrapper files (use system mvn instead)
mvnw
mvnw.cmd
.mvn/

# Gradle build artifacts
build/
.gradle/
gradle-app.setting
!gradle-wrapper.jar
.gradletasknamecache

# CRITICAL: Exclude Gradle wrapper files (use system gradle instead)
gradlew
gradlew.bat
gradle/wrapper/

# IDE files
.idea/
.vscode/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Git files
.git/
.gitignore
.gitattributes

# Documentation and non-essential files
*.md
README*
LICENSE*
CONTRIBUTING*
CODEOWNERS
docs/
documentation/

# Test files (not needed in production image)
src/test/

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
tmp/
temp/

# Docker files (don't copy into image)
Dockerfile*
docker-compose*.yml
.dockerignore

# CI/CD files
.github/
.gitlab-ci.yml
.travis.yml
Jenkinsfile
azure-pipelines.yml

# Migration and analysis files
migration-bundle/
analysis/
reports/

# Hidden files
.*
!.mvn/
