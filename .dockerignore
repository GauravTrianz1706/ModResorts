# Docker ignore file for Java Maven project
# Exclude build artifacts and unnecessary files from Docker context

# Maven build artifacts
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Maven wrapper files (CRITICAL: excluded - use system mvn)
mvnw
mvnw.cmd
.mvn/

# Gradle wrapper files (CRITICAL: excluded - use system gradle)
gradlew
gradlew.bat
gradle/wrapper/

# Gradle build artifacts
build/
.gradle/
gradle.properties

# IDE files
.idea/
.vscode/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
.metadata/

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Git files
.git/
.gitignore
.gitattributes

# Documentation and non-runtime files
*.md
README*
LICENSE
CONTRIBUTING*
CODEOWNERS
docs/
migration-bundle/

# Test files
src/test/

# Logs
*.log
logs/

# Temporary files
*.tmp
*.bak
*.cache

# Docker files (don't copy Docker files into image)
Dockerfile*
docker-compose*.yml
.dockerignore

# Scripts
scripts/

# Kubernetes manifests
kubernetes/
