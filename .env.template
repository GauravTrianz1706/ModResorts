# Environment Configuration Template for Cloud Deployment
# Copy this file and set appropriate values for your environment

# ============================================================================
# Google Cloud Platform Configuration
# ============================================================================
GCP_PROJECT_ID=your-gcp-project-id

# ============================================================================
# Database Configuration (Cloud SQL)
# ============================================================================
# PostgreSQL example:
DB_URL=jdbc:postgresql://CLOUD_SQL_INSTANCE_IP:5432/modresorts
DB_USER=modresorts-user
DB_PASSWORD=<retrieve-from-secret-manager>

# MySQL example (alternative):
# DB_URL=jdbc:mysql://CLOUD_SQL_INSTANCE_IP:3306/modresorts
# DB_USER=modresorts-user
# DB_PASSWORD=<retrieve-from-secret-manager>

# ============================================================================
# Redis Configuration (Memorystore)
# ============================================================================
REDIS_HOST=MEMORYSTORE_REDIS_IP
REDIS_PORT=6379
REDIS_PASSWORD=<optional-if-auth-enabled>

# ============================================================================
# Google Cloud Storage Configuration
# ============================================================================
GCS_BUCKET_NAME=modresorts-config-bucket

# ============================================================================
# Secret Manager Configuration
# ============================================================================
WEATHER_API_KEY_SECRET_NAME=weather-api-key
WEATHER_API_KEY_SECRET_VERSION=latest

# ============================================================================
# Application Configuration
# ============================================================================
PORT=8080

# ============================================================================
# Setup Instructions
# ============================================================================

# 1. Create Cloud SQL Instance
#    gcloud sql instances create modresorts-db \
#      --database-version=POSTGRES_14 \
#      --tier=db-f1-micro \
#      --region=us-central1

# 2. Create Database
#    gcloud sql databases create modresorts --instance=modresorts-db

# 3. Create Memorystore Redis Instance
#    gcloud redis instances create modresorts-redis \
#      --size=1 \
#      --region=us-central1 \
#      --redis-version=redis_6_x

# 4. Create GCS Bucket
#    gsutil mb -p your-project-id gs://modresorts-config-bucket

# 5. Upload Configuration Files to GCS
#    gsutil cp src/main/resources/ops.json gs://modresorts-config-bucket/
#    gsutil cp src/main/resources/reservations.json gs://modresorts-config-bucket/

# 6. Create Secret in Secret Manager
#    echo -n "your-weather-api-key" | \
#      gcloud secrets create weather-api-key \
#        --data-file=- \
#        --replication-policy="automatic"

# 7. Grant Service Account Permissions
#    gcloud projects add-iam-policy-binding your-project-id \
#      --member="serviceAccount:your-service-account@your-project-id.iam.gserviceaccount.com" \
#      --role="roles/cloudsql.client"
#
#    gcloud projects add-iam-policy-binding your-project-id \
#      --member="serviceAccount:your-service-account@your-project-id.iam.gserviceaccount.com" \
#      --role="roles/secretmanager.secretAccessor"
#
#    gcloud projects add-iam-policy-binding your-project-id \
