<?xml version="1.0" encoding="UTF-8"?>
<server description="ModResorts Liberty Server">

    <!-- Enable features required by the application -->
    <featureManager>
        <feature>servlet-3.1</feature>
        <feature>cdi-1.2</feature>
        <feature>jndi-1.0</feature>
        <feature>json-1.0</feature>
        <feature>localConnector-1.0</feature>
    </featureManager>

    <!-- HTTP endpoint -->
    <httpEndpoint id="defaultHttpEndpoint"
                  host="*"
                  httpPort="9080"
                  httpsPort="-1" />

    <!-- Application deployment -->
    <webApplication id="modresorts"
                    location="modresorts.war"
                    contextRoot="/resorts"
                    name="modresorts">
        <classloader apiTypeVisibility="spec, ibm-api, api, stable, third-party"/>
    </webApplication>

    <!-- Logging configuration -->
    <logging consoleLogLevel="INFO"
             traceSpecification="*=info"
             maxFileSize="20"
             maxFiles="5" />

    <!-- JVM options passed via environment -->
    <jvmEntries genericJvmArguments="${env.JAVA_OPTS}"/>

</server>
