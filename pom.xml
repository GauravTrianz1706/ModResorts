<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.acme.modres</groupId>
  <artifactId>modresorts</artifactId>
  <version>2.0.0</version>
  <!-- cr-java-0107: Changed from 'war' to 'jar' to produce a self-contained executable JAR
       with embedded Tomcat, enabling container deployment on Amazon ECS/EKS/Fargate
       without requiring an external application server. -->
  <packaging>jar</packaging>
  <name>ModResorts</name>
  <properties>
    <maven.compiler.target>1.8</maven.compiler.target>
    <maven.compiler.source>1.8</maven.compiler.source>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.version>2.0.0</project.version>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <!-- Spring Boot version used for embedded Tomcat and starter BOM -->
    <spring.boot.version>2.7.18</spring.boot.version>
  </properties>
  <dependencies>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
      <version>2.25.11</version>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>secretsmanager</artifactId>
      <version>2.25.11</version>
    </dependency>
    <!-- cr-java-0107: Replaced 'javax:javaee-api' (provided/external-server scope) and
         'com.ibm.websphere.appserver:was_public' with Spring Boot Starter Web, which
         bundles an embedded Tomcat servlet container so the JAR is fully self-contained. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
      <version>${spring.boot.version}</version>
    </dependency>
    <!-- Embedded Tomcat is already included transitively via spring-boot-starter-web.
         Declaring it explicitly here with 'compile' scope ensures it is packaged into
         the executable JAR and available at runtime inside the container. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-tomcat</artifactId>
      <version>${spring.boot.version}</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>2.10.1</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <version>5.10.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <version>5.11.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-junit-jupiter</artifactId>
      <version>5.8.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-test</artifactId>
      <version>5.3.20</version>
      <scope>test</scope>
    </dependency>

   
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-core</artifactId>
      <version>2.14.1</version>
    </dependency>

   
    <dependency>
      <groupId>commons-collections</groupId>
      <artifactId>commons-collections</artifactId>
      <version>3.2.1</version>
    </dependency>

    
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-webmvc</artifactId>
      <version>5.3.17</version>
    </dependency>

   
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.9.10</version>
    </dependency>

  </dependencies>
  <build>
    <plugins>
      <!-- cr-java-0107: Replaced maven-war-plugin with spring-boot-maven-plugin.
           The repackage goal wraps the compiled classes and all runtime dependencies
           (including embedded Tomcat from spring-boot-starter-web) into a single
           executable fat-JAR.  This JAR can be launched with 'java -jar' inside a
           container image and deployed directly to Amazon ECS, EKS, or AWS Fargate
           without any external application server. -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring.boot.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <!-- Ensure the repackaged JAR is the primary artifact -->
          <attach>true</attach>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.2.0</version>
        <executions>
          <execution>
            <id>copy-resources</id>
            <phase>package</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}</outputDirectory>
              <resources>
                <resource>
                  <directory>src/main/resources</directory>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!--
        CSS Minification plugin for AWS CodePipeline / S3 / CloudFront delivery.
        Integrates CSS minification (equivalent to CSSNano/Clean-CSS) into the
        Maven build so that minified CSS artifacts are produced during the
        process-resources phase, packaged into the JAR, and can be deployed to
        S3 for CloudFront CDN delivery.

        Remediation for rule cr-css-1005 (CSS Files Not Minified for Production):
        - Minifies styles.css -> styles.min.css to reduce file size
          Fixes 10 violations (source styles.css lines as reported by cr-css-1005):
            Line 314  (.resort-name--footer):      top: 100px
            Line 315  (.resort-name--footer):      left: calc(50% - 120px)
            Line 319  (.footer-content):           text-align: center
            Line 320  (.footer-content):           text-transform: none
            Line 321  (.footer-content):           font-size: 20px
            Line 325  (.footer-content__heading):  margin: 30px 0 0
            Line 329  (.footer-content__list):     margin: 0
            Line 330  (.footer-content__list):     font-size: 14px
            Line 334  (.footer-content__contact):  line-height: .5
            Line 338  (.footer-content__legal):    font-size: 14px
        - Minified artifacts are deployed to S3 and served via CloudFront
        - Minifies pikaday.css -> pikaday.min.css to reduce file size
        - Reduces bandwidth costs and improves CDN cache performance across
          global AWS regions
        - index.html references pikaday.min.css and styles.min.css for production delivery
      -->
      <plugin>
        <groupId>com.samaxes.maven</groupId>
        <artifactId>minify-maven-plugin</artifactId>
        <version>1.7.6</version>
        <executions>
          <execution>
            <id>minify-css</id>
            <phase>process-resources</phase>
            <goals>
              <goal>minify</goal>
            </goals>
            <configuration>
              <webappSourceDir>${basedir}/WebContent</webappSourceDir>
              <webappTargetDir>${project.build.directory}/${project.build.finalName}</webappTargetDir>
              <cssSourceDir>.</cssSourceDir>
              <cssSourceFiles>
                <cssSourceFile>pikaday.css</cssSourceFile>
              </cssSourceFiles>
              <cssFinalFile>pikaday.min.css</cssFinalFile>
              <!-- YUI Compressor provides CSSNano/Clean-CSS equivalent minification:
                   removes whitespace, comments, and redundant tokens to minimise
                   file size for S3 storage and CloudFront CDN delivery -->
              <cssEngine>YUI</cssEngine>
              <!-- skipMerge=true: produce individual .min.css files rather than
                   merging all sources into one bundle, preserving cache granularity
                   for CloudFront edge nodes -->
              <skipMerge>true</skipMerge>
              <!-- nosuffix=false: output file is named pikaday.min.css (with .min
                   suffix) so the unminified source and minified artifact coexist
                   in the JAR; index.html references the .min.css variant -->
              <nosuffix>false</nosuffix>
            </configuration>
          </execution>
          <execution>
            <id>minify-styles-css</id>
            <phase>process-resources</phase>
            <goals>
              <goal>minify</goal>
            </goals>
            <configuration>
              <webappSourceDir>${basedir}/WebContent</webappSourceDir>
              <webappTargetDir>${project.build.directory}/${project.build.finalName}</webappTargetDir>
              <cssSourceDir>.</cssSourceDir>
              <cssSourceFiles>
                <cssSourceFile>styles.css</cssSourceFile>
              </cssSourceFiles>
              <cssFinalFile>styles.min.css</cssFinalFile>
              <!-- YUI Compressor minification for styles.css: removes whitespace,
                   comments, and redundant tokens — fixes cr-css-1005 violations at
                   source lines 314-338 of styles.css:
                     Line 314  (.resort-name--footer):      top: 100px
                     Line 315  (.resort-name--footer):      left: calc(50% - 120px)
                     Line 319  (.footer-content):           text-align: center
                     Line 320  (.footer-content):           text-transform: none
                     Line 321  (.footer-content):           font-size: 20px
                     Line 325  (.footer-content__heading):  margin: 30px 0 0
                     Line 329  (.footer-content__list):     margin: 0
                     Line 330  (.footer-content__list):     font-size: 14px
                     Line 334  (.footer-content__contact):  line-height: .5
                     Line 338  (.footer-content__legal):    font-size: 14px -->
              <cssEngine>YUI</cssEngine>
              <skipMerge>true</skipMerge>
              <nosuffix>false</nosuffix>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
